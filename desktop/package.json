{
  "name": "sirplus-talk-desktop",
  "productName": "Sirplus Talk",
  "version": "0.1.0",
  "description": "Fast Nextcloud Talk desktop client",
  "license": "AGPL-3.0-or-later",
  "author": "Sirplus Talk contributors",
  "homepage": "https://github.com/raph-ael/nextcloud-talk-legacy",
  "desktopName": "sirplus-talk.desktop",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "core": "scripts/build-core.sh",
    "core:release": "PROFILE=release scripts/build-core.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist:linux": "scripts/linux-icon.sh && npm run core:release && electron-vite build && electron-builder --linux",
    "dist:mac": "scripts/mac-icon.sh && PROFILE=release UNIVERSAL=1 scripts/build-core.sh && electron-vite build && electron-builder --mac --universal",
    "dist:deb": "scripts/linux-icon.sh && npm run core:release && electron-vite build && electron-builder --linux deb"
  },
  "build": {
    "appId": "org.sirplus.talk",
    "productName": "Sirplus Talk",
    "files": [
      "out/**/*",
      "resources/tray.png"
    ],
    "extraResources": [
      {
        "from": "native/talk_node.node",
        "to": "native/talk_node.node"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "sirplus-talk",
      "category": "Network;InstantMessaging",
      "icon": "build/icons",
      "synopsis": "Nextcloud Talk desktop client",
      "description": "Fast desktop client for Nextcloud Talk: chats, voice and video calls, screen sharing.",
      "maintainer": "Sirplus Talk contributors",
      "desktop": {
        "entry": {
          "Keywords": "Nextcloud;Talk;Chat;Call;"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "x64ArchFiles": "Contents/Resources/native/talk_node.node",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Für Anrufe und zum Aufnehmen von Sprachnachrichten.",
        "NSCameraUsageDescription": "Für Videoanrufe."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "dmg": {
      "title": "${productName}"
    },
    "deb": {
      "packageCategory": "net",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libpipewire-0.3-0t64 | libpipewire-0.3-0"
      ],
      "recommends": [
        "xdg-desktop-portal",
        "pipewire"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "emoji-mart": "^5.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
