{
  "name": "sirplus-talk-desktop",
  "productName": "Sirplus Talk",
  "version": "0.1.0",
  "description": "Fast Nextcloud Talk desktop client",
  "license": "AGPL-3.0-or-later",
  "author": "Sirplus Talk contributors",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "core": "scripts/build-core.sh",
    "core:release": "PROFILE=release scripts/build-core.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist:linux": "npm run core:release && electron-vite build && electron-builder --linux",
    "dist:mac": "PROFILE=release UNIVERSAL=1 scripts/build-core.sh && electron-vite build && electron-builder --mac --universal"
  },
  "build": {
    "appId": "org.sirplus.talk",
    "productName": "Sirplus Talk",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "native/talk_node.node",
        "to": "native/talk_node.node"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;InstantMessaging",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "x64ArchFiles": "Contents/Resources/native/talk_node.node",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Zum Aufnehmen von Sprachnachrichten."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "dmg": {
      "title": "${productName}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "emoji-mart": "^5.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
